//
// Simple shader to output some vertex attributes to different output targets
// For now will write out 2 outputs: position and normals in world space.
//

//#include "Common.ogsfh"


uniform texture2D firstDepthTex : FirstDepthTexture;
uniform sampler2D firstDepthSamp = sampler_state
{
    Texture = <firstDepthTex>;
};

uniform texture2D firstIDTex : FirstIDTexture;
uniform sampler2D firstIDSamp = sampler_state
{
    Texture = <firstIDTex>;
};


attribute VS_INPUT
{
    vec3 Pm : POSITION;
    vec3 Nm : NORMAL;
    vec3 Cd : COLOR0;
}
attribute VS_TO_PS
{
    float Depthw : TEXCOORD0;
    vec3 IDw : TEXCOORD1;
    vec3 Nw: TEXCOORD2;
}
/*
    Switch
*/
uniform bool DISPLAY_COLOR = true;




/*
    ViewPort
*/
uniform vec3 cameraViewDirection : ViewDirection;
uniform vec4 gUVTransform : RelativeViewportDimensions;
uniform vec3 MyColor = {0.8, 0.2, 0.2};
uniform vec2 gViewportSizePixels = { 0.0, 0.0 };
uniform vec2 gSourceSizePixels = { 0.0, 0.0 };



/*
    Globals
*/
uniform mat4 WorldIT : worldinversetranspose;
uniform mat4 World : world;
uniform float DepthPriority : depthpriority;
uniform mat4 WorldViewProj : worldviewprojection;



/*
    Light Model
*/
// Reflection Parm
uniform float Kd = 0.5;
// Light Intensity
uniform float intensity = 0.7;
uniform vec3 baseColor = {0.85, 0.85, 0.85};





GLSLShader VS_GeometryAttributes
{

    vec4 iPcPriority( vec3 pm, float depthPriority, mat4 worldViewProjectionC )
    {
        vec4 P = worldViewProjectionC * vec4(pm,1);
        P.z -= P.w * 2.0 * depthPriority;
        return P;
    }

    void main()
    {
        IDw = Cd;
        vec4 screenPos = WorldViewProj * vec4(Pm, 1);;
        Nw = Nm;
        gl_Position= iPcPriority ( Pm, DepthPriority, WorldViewProj );
    }
}


attribute PS_OUT
{
    vec4 colorOut[2];
}

GLSLShader PS_GeometryAttributes
{
    float near = 0.001; 
    float far  = 10.0; 
    float LinearizeDepth(float depth) 
    {
        float z = depth * 2.0 - 1.0; // back to NDC 
        return (2.0 * near * far) / (far + near - z * (far - near));    
    }
    bool diffID(float curDepth)
    {
        for (int i = -2; i <= 2; i ++)
        {
            for (int j = -2; j <= 2; j ++)
            {
                vec4 _Depth = texture2D(firstDepthSamp, vec2((gl_FragCoord.x + float(i))/gViewportSizePixels[0], (gl_FragCoord.y + float(j))/gViewportSizePixels[1]) );
                vec4 _ID = texture2D(firstIDSamp, vec2((gl_FragCoord.x + float(i))/gViewportSizePixels[0], (gl_FragCoord.y + float(j))/gViewportSizePixels[1]) );
                if ( abs( _Depth.x - curDepth ) > 0.0001 )
                {
                    continue;
                }
                if ( abs( _ID.y- 0.36 ) < 0.0001)
                {
                    continue;
                }
                if ( abs( IDw.y-_ID.y ) > 0.001)
                {
                    return true;
                }
            }
        }
        return false;
    }


    vec3 LambertLight(vec3 _normal, vec3 _lightDirection, vec3 _baseColor)
    {
        float diffuseLight = intensity * dot(_normal, _lightDirection);
        if (DISPLAY_COLOR)
            return Kd * diffuseLight * _baseColor;
        else
            return Kd * diffuseLight * baseColor;
        //return vec3(0.5, 0.5, 0.5);
    }

    void main()
    {
        //vec3 camLightDirection =  * lightDirection;
        colorOut[0] = vec4( LambertLight(Nw, -cameraViewDirection, IDw), 1.0);


        // Test Intersection
        vec4 firstDepth = texture2D(firstDepthSamp, vec2(gl_FragCoord.x/gViewportSizePixels[0], gl_FragCoord.y/gViewportSizePixels[1]) );
        float currentDepth = LinearizeDepth(gl_FragCoord.z);
        if(abs(currentDepth-firstDepth.x) < 0.001 )
        {
            bool _diifID = diffID(currentDepth);
            if (_diifID)
            {
                colorOut[0] = vec4(1.0, 0.0, 0.0, 1.0);
            }

        }
        colorOut[1] = texture2D(firstIDSamp, vec2(gl_FragCoord.x/gViewportSizePixels[0], gl_FragCoord.y/gViewportSizePixels[1]) );
    }
}


// Technique.
technique Main
{
    pass p0
    {
        VertexShader (in VS_INPUT, out VS_TO_PS) = VS_GeometryAttributes;
        PixelShader (in VS_TO_PS, out PS_OUT) = PS_GeometryAttributes;
    }
}
